// Example only: merge the two `allow read` lines into the live Firestore rules (Firebase Console > Firestore > Rules).
// In-game history lists every round saved under the same player name, so signed-in (anonymous) users must be able to
// read players and their sessions. Writes stay limited to the browser that owns the record.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{playerId} {
      allow read: if request.auth != null;
      match /sessions/{sessionId} {
        allow read: if request.auth != null;
      }
    }
  }
}
